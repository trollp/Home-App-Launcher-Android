<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/usage_dashboard" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/usage_estimate_note" />
  <TextView android:id="@+id/stateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
  <Button android:id="@+id/usageSettingsButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/open_usage_settings" />
  <Button android:id="@+id/retryButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" />
  <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:id="@+id/todayTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textAppearance="?attr/textAppearanceTitleLarge" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/by_app" android:textStyle="bold" />
   <LinearLayout android:id="@+id/appBreakdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/seven_day_trend" android:textStyle="bold" />
   <TextView android:id="@+id/trend" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:lineSpacingExtra="6dp" />
  </LinearLayout>
  <Button android:id="@+id/doneButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/done" />
 </LinearLayout>
</ScrollView>
