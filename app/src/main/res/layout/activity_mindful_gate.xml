<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/gateTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView android:id="@+id/intentPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textAppearance="?attr/textAppearanceTitleLarge" />
        <Button android:id="@+id/openButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="@string/open_now" />
        <Button android:id="@+id/cancelButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/cancel" />
        <Button android:id="@+id/bypassButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/bypass_once" />
    </LinearLayout>
</ScrollView>
