<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="24dp">
    <TextView android:id="@+id/blockedTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    <TextView android:id="@+id/blockReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="?attr/textAppearanceBodyLarge" />
    <Button android:id="@+id/overrideButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp" android:text="@string/override_five_minutes" />
    <Button android:id="@+id/cancelButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/go_back" />
</LinearLayout>
