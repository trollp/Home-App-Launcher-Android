<resources>
    <style name="Theme.QuietHome" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/quiet_primary</item>
        <item name="colorPrimaryVariant">@color/quiet_primary</item>
        <item name="colorOnPrimary">@color/quiet_on_primary</item>
        <item name="colorAccent">@color/quiet_primary</item>
        <item name="colorSurface">@color/quiet_surface</item>
        <item name="colorOnSurface">@color/quiet_on_surface</item>
        <item name="colorOnBackground">@color/quiet_on_background</item>
        <item name="android:colorBackground">@color/quiet_background</item>
        <item name="android:textColorPrimary">@color/quiet_on_background</item>
        <item name="android:textColorSecondary">@color/quiet_secondary_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/quiet_background</item>
        <item name="android:navigationBarColor">@color/quiet_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.QuietHome.IconOnly" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="Widget.QuietHome.AllAppsButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#000000</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="strokeColor">#000000</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
