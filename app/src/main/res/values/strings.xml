    <string name="permissions_intro">Everything is optional. Quiet Home remains usable if you choose Not now. Grant only features you want.</string>
    <string name="default_home_explanation">Default Home: lets Quiet Home appear when you press Home.</string>
    <string name="usage_explanation">Usage access: measures today’s app time for daily limits. Without it, limits fail open.</string>
    <string name="notification_access_explanation">Notification access: enables your local allow, batch, and silence choices. Critical notifications are left alone.</string>
    <string name="notification_permission_explanation">Notification permission: allows approximate local session-end reminders and rate-limited warnings when usage limits cannot be enforced.</string>
    <string name="accessibility_explanation">Accessibility: enables double-tap screen lock and reliable notification gestures. It can also provide optional external-app enforcement; rules fail open on errors.</string>
    <string name="grayscale_explanation">Experimental grayscale: optional, device-dependent secure color correction for selected apps. It needs an explicit ADB grant.</string>
